# Secrets and local configuration
.env
.env.*
!.env.example
# Glob, not an exact match: backups and variants carry the same
# cluster-specific paths and must not be committed either.
configs/cluster.env*
!configs/cluster.env.example

# Local tool state
.cursor/
.vscode/
.idea/
.local/
.DS_Store

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# Model and dataset caches
.cache/
hf_cache/
data/
models/
checkpoints/
outputs/
*.safetensors
*.pt
*.pth
*.ckpt
*.bin

# Container artifacts
*.sqsh
*.sif
*.tar
containers/images/

# Logs and experiment tracking
logs/
runs/
tensorboard/
wandb/
slurm-*.out
slurm-*.err

# Temporary files
tmp/
*.tmp
*.swp

# Raw run artifacts: full logs, checkpoints, per-question outputs. Large and
# regenerable. The curated summaries under results/summary/ stay tracked as the
# reviewable record of what actually ran.
results/raw/

# Prose is staged by hand while it is still being drafted.
# Use git add -f to include a specific file.
*.md
docs/
