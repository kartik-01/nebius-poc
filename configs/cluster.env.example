# Copy to configs/cluster.env and fill in from scripts/discover_cluster.sh.
# Gitignored. Values differ per cluster, so none of them are baked into scripts.

# From: sinfo, scontrol show partition, sacctmgr show assoc user=$USER
SLURM_PARTITION=
SLURM_ACCOUNT=
SLURM_QOS=

# Durable shared storage, readable from every compute node.
# From: df -hT
SHARED_ROOT=

# Node-local scratch for tokenized data, checkpoint staging, and fio.
# From: df -hT inside an allocation. If the nodes have no local disk, leave
# empty and note the fallback to SHARED_ROOT.
LOCAL_SCRATCH=

# Put this under SHARED_ROOT so jobs can run with HF_HUB_OFFLINE=1 after prefetch.
HF_HOME=

# Record the resolved digest, not just the tag.
TRAIN_IMAGE=
VALIDATOR_IMAGE=
VLLM_IMAGE=

# Comma separated source:destination pairs.
# From: srun --help | grep container-mounts
CONTAINER_MOUNTS=

# Leave empty until discovery confirms them. Guessing these usually makes NCCL
# worse, not better.
# From: ibv_devices, ibv_devinfo -l, ip -o link
UCX_NET_DEVICES=
NCCL_SOCKET_IFNAME=
NCCL_IB_HCA=
